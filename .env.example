# Publik adress som används i metadata, sitemap och strukturerad data
NEXT_PUBLIC_SITE_URL=https://www.lbcentreprenad.se

# Offertformuläret skickar e-post via Resend (https://resend.com).
# Utan dessa värden visar formuläret ett tydligt felmeddelande med telefon och e-post.
RESEND_API_KEY=
# Avsändare på en domän som är verifierad i Resend
QUOTE_FROM_EMAIL="LBC Entreprenad <offert@lbcentreprenad.se>"
# Mottagare (standard: kontakt@lbcentreprenad.se)
QUOTE_TO_EMAIL=kontakt@lbcentreprenad.se
